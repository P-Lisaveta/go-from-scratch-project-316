[0.465, "o", "\u001b[39D\u001b[27m \u001b[27m \u001b[27mg\u001b[27mo\u001b[27m \u001b[27mr\u001b[27mu\u001b[27mn\u001b[27m \u001b[27m.\u001b[27m/\u001b[27mc\u001b[27mm\u001b[27md\u001b[27m/\u001b[27mh\u001b[27me\u001b[27mx\u001b[27ml\u001b[27me\u001b[27mt\u001b[27m-\u001b[27mg\u001b[27mo\u001b[27m-\u001b[27mc\u001b[27mr\u001b[27ma\u001b[27mw\u001b[27ml\u001b[27me\u001b[27mr\u001b[27m \u001b[27m-\u001b[27m-\u001b[27mh\u001b[27me\u001b[27ml\u001b[27mp"]
[0.000, "o", "\u001b[?1l\u001b>\u001b[?2004l\r\r\n"]
[0.001, "o", "\u001b]2;go run ./cmd/hexlet-go-crawler --help\u0007\u001b]1;go\u0007"]
[0.129, "o", "NAME:\r\n"]
[0.000, "o", "   hexlet-go-crawler - analyze a website structure\r\n\r\nUSAGE:\r\n"]
[0.000, "o", "   hexlet-go-crawler [global options] command [command options]\r\n\r\n"]
[0.000, "o", "COMMANDS:\r\n"]
[0.000, "o", "   help, h  Shows a list of commands or help for one command\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "GLOBAL OPTIONS:\r\n"]
[0.000, "o", "   --depth value       crawl depth (default: 10)\r\n   --retries value     number of retries for failed requests (default: 1)\r\n"]
[0.000, "o", "   --delay value       delay between requests (example: 200ms, 1s) (default: 0s)\r\n"]
[0.000, "o", "   --timeout value     per-request timeout (default: 15s)"]
[0.000, "o", "\r\n"]
[0.000, "o", "   --rps value         "]
[0.000, "o", "limit requests per second (overrides delay) (default: 0)\r\n"]
[0.000, "o", "   --user-agent value  "]
[0.000, "o", "custom user agent\r\n"]
[0.000, "o", "   --workers value"]
[0.000, "o", "     number of concurrent workers (default: 4)"]
[0.000, "o", "\r\n   --help, -h        "]
[0.000, "o", "  show help"]
[0.000, "o", "\r\n"]
